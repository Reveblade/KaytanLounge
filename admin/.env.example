# Backend upstream used by the same-origin proxy at /api/v1 (server-side only).
# Production: https://api.baskaistanbulyok.com/api/v1
BIY_API_URL=http://127.0.0.1:3300/api/v1

# Cookie signing for the BFF session cookies (any long random string)
SESSION_COOKIE_SECRET=change-me-admin-cookie-secret

NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Origin the browser uses for API-hosted media (must match the API API_PUBLIC_ORIGIN).
# Production: https://api.baskaistanbulyok.com
NEXT_PUBLIC_API_PUBLIC_ORIGIN=http://127.0.0.1:3300
