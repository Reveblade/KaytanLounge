# Runtime
NODE_ENV=development
PORT=3300
HOST=127.0.0.1
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=debug

# Browser origins allowed to call the API directly. The Next apps proxy server-side,
# so this mostly matters for local tooling and Swagger.
CORS_ORIGINS=http://localhost:3301,http://localhost:3302,https://baskaistanbulyok.com,https://admin.baskaistanbulyok.com

# Public origins of the two Next apps (used in ticket links)
WEBSITE_ORIGIN=http://localhost:3302
ADMIN_ORIGIN=http://localhost:3301

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=baska_istanbul_yok

# Auth. Admin sessions are issued here; customer sessions are issued after a Kuwho exchange.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_SALT_ROUNDS=12

# Owner account written by `npm run seed` (only when no owner exists yet)
OWNER_EMAIL=admin@kuwho.com
OWNER_PASSWORD=Demo1234!
OWNER_NAME=Owner

# Kuwho customer identity (phone / email OTP, Google, Meta all live there)
KUWHO_API_URL=https://api.kuwho.com/api/v1
KUWHO_TIMEOUT_MS=20000

# Reverse proxy hops in front of the API (Cloud Run: 1)
TRUST_PROXY=0

# Seat holds: how long an unpaid booking keeps its seats
BOOKING_HOLD_MINUTES=30
# Manual approval window before an awaiting-approval booking expires
BOOKING_APPROVAL_HOURS=24

# Payments. Phase 1 keeps every provider in MANUAL mode: the UI collects the choice and
# the booking waits for an admin to approve. Flip to LIVE once a gateway is wired.
PAYMENTS_MODE=manual
PAYMENT_PROVIDERS=iyzico,stripe,bank_transfer
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
BANK_TRANSFER_IBAN=
BANK_TRANSFER_HOLDER=Kaytan Lounge Turizm

# Media: Cloudinary when configured, otherwise files are written to MEDIA_LOCAL_DIR and
# served from /api/v1/media/files. Cloud Run disks are ephemeral: use Cloudinary there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=biy
MEDIA_LOCAL_DIR=./uploads
MEDIA_MAX_FILE_BYTES=15728640

# Route geometry between nodes. osrm calls ROUTING_OSRM_URL; straight draws lines.
ROUTING_PROVIDER=osrm
ROUTING_OSRM_URL=https://router.project-osrm.org
# Stops closer than this are walked, not driven: the car profile turns a 400 m
# stroll across Sultanahmet into a 2 km loop around the one-way grid.
ROUTING_WALK_MAX_KM=1.2
# Douglas-Peucker tolerance for the stored line, in metres. OSRM emits a vertex
# every ~15 m, far below one pixel at the zooms routes are drawn at.
ROUTING_SIMPLIFY_METERS=8

# Where browsers reach this API. Used to build URLs for locally stored media.
# Production: https://api.baskaistanbulyok.com
API_PUBLIC_ORIGIN=http://127.0.0.1:3300
# Sent when re-hosting licensed photos. Wikimedia requires a contact address here.
MEDIA_IMPORT_USER_AGENT=
